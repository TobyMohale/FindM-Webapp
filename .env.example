# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL="https://ywpidzojetdhyezmkjxb.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase anonymous API key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# RESEND_API_KEY: Your Resend API Key for automatic email alerts
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Sender email address verified on Resend (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=

# RESEND_TEST_RECIPIENT: The verified email address of your Resend account owner (e.g. findmewebapp7@gmail.com).
# In Sandbox Mode (onboarding@resend.dev), Resend ONLY permits sending emails to this address!
RESEND_TEST_RECIPIENT=

# GOOGLE_CLIENT_ID: Your Google Cloud Console OAuth 2.0 Web Client ID for admin authentication
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google Cloud Console OAuth 2.0 Web Client Secret for admin authentication
GOOGLE_CLIENT_SECRET=

# ADMIN_SETUP_PASSWORD: Password used only during initial admin creation if user does not exist in Supabase Auth
ADMIN_SETUP_PASSWORD=

